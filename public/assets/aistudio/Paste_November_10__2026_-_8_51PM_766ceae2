      const [filterAction, setFilterAction] = useState("ALL");
      const [searchQuery, setSearchQuery] = useState("");
      
      // Selected stock for deep dive modal
      const [selectedStock, setSelectedStock] = useState(null);

      // Fundamental Injector State
      const [injectorTarget, setInjectorTarget] = useState("RELIANCE");
      const [metricName, setMetricName] = useState("");
      const [metricValue, setMetricValue] = useState("");
      const [metricType, setMetricType] = useState("BULLISH");
      const [toastMsg, setToastMsg] = useState("");

      // AI Prompt Sandbox State
      const [aiPersonaPrompt, setAiPersonaPrompt] = useState(
        "Refine screening for: High ROCE (>20%), robust domestic consumption tailwinds, and institutional FII accumulation. Downgrade stocks facing regulatory risk or margin contraction."
      );
      const [isReframing, setIsReframing] = useState(false);
      const [reframeHistory, setReframeHistory] = useState([
        { time: "09:15 AM", prompt: "Standard Multi-Factor Quant Algorithm (NSE Nifty 50 Universe)" }
      ]);

      // Daily Accuracy & Backtest State
      const [backtestPeriod, setBacktestPeriod] = useState("1Y");
      const [dailyAccuracyRate, setDailyAccuracyRate] = useState(82.6);
      const [autoCalibrating, setAutoCalibrating] = useState(false);

      // Trigger Icon render when view updates
      useEffect(() => {
        if (window.lucide) {
          window.lucide.createIcons();
        }
      }, [activeTab, stocks, selectedStock]);

      // Helper to trigger floating toast
      const showToast = (msg) => {
        setToastMsg(msg);
        setTimeout(() => setToastMsg(""), 3500);
      };

      // Filtered stock list
      const filteredStocks = useMemo(() => {
        return stocks.filter(stock => {
          const matchesAction = filterAction === "ALL" || stock.action === filterAction;
          const matchesSearch = stock.symbol.toLowerCase().includes(searchQuery.toLowerCase()) ||
                                stock.name.toLowerCase().includes(searchQuery.toLowerCase()) ||
                                stock.sector.toLowerCase().includes(searchQuery.toLowerCase());
          return matchesAction && matchesSearch;
        });
      }, [stocks, filterAction, searchQuery]);

      // Custom Fundamental Injection Handler
      const handleAddFundamental = (e) => {
        e.preventDefault();
        if (!metricName.trim() || !metricValue.trim()) return;

        setStocks(prev => prev.map(stock => {
          if (stock.symbol === injectorTarget) {
            let updatedConviction = stock.conviction;
            let updatedTarget = stock.target;
            let updatedAction = stock.action;

            if (metricType === "BULLISH") {
              updatedConviction = Math.min(99, stock.conviction + 4);
              updatedTarget = Number((stock.target * 1.035).toFixed(1));
              if (stock.action === "SELL") updatedAction = "HOLD";
              else if (stock.action === "HOLD") updatedAction = "BUY";
            } else {
              updatedConviction = Math.max(45, stock.conviction - 5);
              updatedTarget = Number((stock.target * 0.965).toFixed(1));
              if (stock.action === "BUY") updatedAction = "HOLD";
              else if (stock.action === "HOLD") updatedAction = "SELL";
            }

            const newNote = {
              metric: metricName,
              value: metricValue,
              sentiment: metricType,
              date: new Date().toLocaleDateString("en-IN", { day: 'numeric', month: 'short', year: 'numeric' })
            };

            return {
              ...stock,
              conviction: updatedConviction,
              target: updatedTarget,
              action: updatedAction,
              customNotes: [newNote, ...stock.customNotes],
              catalysts: [`[User Injected] ${metricName}: ${metricValue}`, ...stock.catalysts]
            };
          }
          return stock;
        }));

        showToast(`✅ Injected "${metricName}" into ${injectorTarget}. AI recalculation finished!`);
        setMetricName("");
        setMetricValue("");
      };

      // Run AI Prompt Reframe
      const handleRunReframe = () => {
        setIsReframing(true);
        setTimeout(() => {
          // Re-evaluate stocks based on prompt keywords
          const promptLower = aiPersonaPrompt.toLowerCase();
          setStocks(prev => prev.map(stock => {
            let action = stock.action;
            let conviction = stock.conviction;
            let catalysts = [...stock.catalysts];

            // If prompt emphasizes retail/consumption
            if (promptLower.includes("consumption") || promptLower.includes("retail")) {
              if (stock.sector.includes("Retail") || stock.sector.includes("FMCG")) {
                action = "BUY";
                conviction = Math.min(98, conviction + 6);
                catalysts = ["[AI Reframe] Primed for consumption boost", ...catalysts];
              }
            }

            // If prompt emphasizes defensive / low debt
            if (promptLower.includes("defensive") || promptLower.includes("low debt")) {
              if (stock.debtToEquity < 0.2) {
                conviction = Math.min(97, conviction + 5);
                catalysts = ["[AI Reframe] Low-debt balance sheet prioritized", ...catalysts];
              }
