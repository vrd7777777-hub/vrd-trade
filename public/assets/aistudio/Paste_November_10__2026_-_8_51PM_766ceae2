                      value={aiPersonaPrompt}
                      onChange={(e) => setAiPersonaPrompt(e.target.value)}
                      className="w-full bg-[#070b12] border border-slate-700 rounded-xl p-3.5 text-xs text-slate-200 font-mono focus:outline-none focus:border-purple-500 leading-relaxed"
                      placeholder="Give a prompt to reframe the entire algorithm..."
                    ></textarea>

                    <button
                      onClick={handleRunReframe}
                      disabled={isReframing}
                      className="w-full py-3.5 rounded-xl bg-gradient-to-r from-purple-600 via-indigo-600 to-emerald-500 hover:opacity-95 text-white font-extrabold text-xs uppercase tracking-wider shadow-lg shadow-purple-500/20 transition-all flex items-center justify-center space-x-2"
                    >
                      <i data-lucide="cpu" className={`w-4 h-4 ${isReframing ? "animate-spin" : ""}`}></i>
                      <span>{isReframing ? "Re-synthesizing AI Weightings..." : "Reframe & Apply to VRD Trade AI"}</span>
                    </button>
                  </div>
                </div>

                {/* Audit Trail of Applied Reframes */}
                <div className="bg-[#0c121d] border border-slate-800 rounded-2xl p-6 shadow-xl">
                  <h3 className="text-sm font-bold text-white mb-3 flex items-center space-x-2">
                    <i data-lucide="file-code-2" className="w-4 h-4 text-purple-400"></i>
                    <span>Active Reframe Log History</span>
                  </h3>
                  
                  <div className="space-y-2.5">
                    {reframeHistory.map((item, idx) => (
                      <div key={idx} className="p-3 rounded-xl bg-[#070b12] border border-slate-800/80 flex items-start space-x-3">
                        <span className="text-[10px] font-mono text-purple-400 bg-purple-500/10 px-2 py-0.5 rounded mt-0.5">{item.time}</span>
                        <div className="flex-1">
                          <p className="text-xs font-mono text-slate-300">{item.prompt}</p>
                        </div>
                        <span className="text-[10px] text-emerald-400 font-bold">Executed</span>
                      </div>
                    ))}
                  </div>
                </div>

              </div>
            )}

          </main>

          {/* INSPECTION MODAL */}
          {selectedStock && (
            <div className="fixed inset-0 z-50 bg-black/80 backdrop-blur-sm flex items-center justify-center p-4 overflow-y-auto">
              <div className="bg-[#0c121d] border border-slate-700 max-w-2xl w-full rounded-2xl p-6 shadow-2xl relative my-8">
                
                <button
                  onClick={() => setSelectedStock(null)}
                  className="absolute top-4 right-4 p-2 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-300"
                >
                  <i data-lucide="x" className="w-4 h-4"></i>
                </button>

                <div className="flex items-start justify-between pr-8">
                  <div>
                    <div className="flex items-center space-x-2">
                      <h2 className="text-2xl font-black text-white">{selectedStock.symbol}</h2>
                      <span className="text-xs font-mono text-slate-400 bg-slate-800 px-2 py-0.5 rounded">NSE / BSE</span>
                    </div>
                    <p className="text-sm text-slate-400">{selectedStock.name} • {selectedStock.sector}</p>
                  </div>

                  <span className={`px-4 py-1.5 rounded-full text-xs font-black tracking-wider ${
                    selectedStock.action === "BUY" ? "bg-emerald-500/20 text-emerald-400 border border-emerald-500/40" :
                    selectedStock.action === "SELL" ? "bg-rose-500/20 text-rose-400 border border-rose-500/40" :
                    "bg-amber-500/20 text-amber-400 border border-amber-500/40"
                  }`}>
                    {selectedStock.action}
                  </span>
                </div>

                {/* Quant Breakdown */}
                <div className="grid grid-cols-2 sm:grid-cols-4 gap-3 my-5 font-mono-numbers">
                  <div className="p-3 rounded-xl bg-[#070b12] border border-slate-800">
                    <span className="text-[10px] text-slate-400 block">CMP</span>
                    <span className="text-base font-extrabold text-white">₹{selectedStock.cmp}</span>
                  </div>
                  <div className="p-3 rounded-xl bg-[#070b12] border border-slate-800">
                    <span className="text-[10px] text-slate-400 block">AI TARGET</span>
                    <span className="text-base font-extrabold text-emerald-400">₹{selectedStock.target}</span>
                  </div>
                  <div className="p-3 rounded-xl bg-[#070b12] border border-slate-800">
                    <span className="text-[10px] text-slate-400 block">STOP LOSS</span>
                    <span className="text-base font-extrabold text-rose-400">₹{selectedStock.stoploss}</span>
                  </div>
                  <div className="p-3 rounded-xl bg-[#070b12] border border-slate-800">
                    <span className="text-[10px] text-slate-400 block">CONVICTION</span>
                    <span className="text-base font-extrabold text-cyan-400">{selectedStock.conviction}%</span>
                  </div>
                </div>

                {/* Fundamental Metrics Table */}
                <div className="bg-[#070b12] p-4 rounded-xl border border-slate-800 mb-5">
                  <h4 className="text-xs font-bold uppercase tracking-wider text-slate-400 mb-2">Fundamental Profile</h4>
                  <div className="grid grid-cols-2 sm:grid-cols-4 gap-4 text-xs font-mono-numbers">
                    <div>
                      <span className="text-slate-500 block text-[10px]">P/E Ratio</span>
                      <strong className="text-slate-200">{selectedStock.pe}</strong>
                    </div>
                    <div>
                      <span className="text-slate-500 block text-[10px]">PEG Ratio</span>
                      <strong className="text-slate-200">{selectedStock.peg}</strong>
                    </div>
                    <div>
                      <span className="text-slate-500 block text-[10px]">Debt / Equity</span>
                      <strong className="text-slate-200">{selectedStock.debtToEquity}</strong>
                    </div>
                    <div>
                      <span className="text-slate-500 block text-[10px]">Promoter Holding</span>
                      <strong className="text-slate-200">{selectedStock.promoterHolding}</strong>
                    </div>
                  </div>
                </div>

                {/* Comprehensive Reasons */}
                <div>
                  <h4 className="text-xs font-bold uppercase tracking-wider text-white mb-2 flex items-center space-x-1.5">
                    <i data-lucide="check-circle-2" className="w-4 h-4 text-emerald-400"></i>
                    <span>Exhaustive AI Signal Rationales:</span>
                  </h4>
                  <div className="space-y-2">
                    {selectedStock.catalysts.map((cat, i) => (
                      <div key={i} className="p-2.5 rounded-lg bg-[#070b12] border border-slate-800/80 text-xs text-slate-300 flex items-start space-x-2">
                        <span className="text-cyan-400 font-bold">#{i+1}</span>
                        <span>{cat}</span>
                      </div>
                    ))}
                  </div>
                </div>

                <div className="mt-6 flex justify-end">
                  <button
                    onClick={() => setSelectedStock(null)}
                    className="px-5 py-2 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-200 text-xs font-bold"
                  >
                    Close Terminal View
                  </button>
                </div>

              </div>
            </div>
          )}

          {/* FOOTER */}
          <footer className="border-t border-slate-800/80 bg-[#070a10] py-4 text-center text-xs text-slate-500">
            <p>VRD Trade ai — Specifically engineered for National Stock Exchange (NSE) & Bombay Stock Exchange (BSE) Equities.</p>
            <p className="text-[10px] text-slate-600 mt-1">Disclaimer: For quantitative algorithmic research & educational analysis. Consult a SEBI-registered advisor before executing live capital trades.</p>
          </footer>

        </div>
      );
    }

    ReactDOM.createRoot(document.getElementById("root")).render(<App />);
  </script>
</body>
</html>