                              ? "bg-emerald-500 text-slate-950 font-extrabold shadow-lg shadow-emerald-500/20"
                              : status === "SELL"
                              ? "bg-rose-500 text-white font-extrabold shadow-lg shadow-rose-500/20"
                              : status === "HOLD"
