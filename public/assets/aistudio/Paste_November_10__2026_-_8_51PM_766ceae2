                    />
                  </div>

                  <div className="flex items-center space-x-2 w-full md:w-auto overflow-x-auto pb-1 md:pb-0">
                    <span className="text-xs text-slate-400 font-medium whitespace-nowrap">Filter Call:</span>
                    {["ALL", "BUY", "HOLD", "SELL"].map((status) => (
                      <button
